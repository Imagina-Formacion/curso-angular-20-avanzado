      "  const ${4:authService} = inject(${1:AuthService});",
      "  const router = inject(Router);",
      "",
      "  if (${4:authService}.${5:isAuthenticated}()) {",
      "    return true;",
      "  }",
      "",
      "  // Redirect to login with return URL",
      "  router.navigate(['${6:/auth/login}'], {",
      "    queryParams: { returnUrl: state.url }",
      "  });",
      "  return false;",
      "};"
    ],
    "description": "Guard funcional para protección de rutas"
  },

  "Angular 20 Injectable Service": {
    "prefix": "ng20-service",
    "body": [
