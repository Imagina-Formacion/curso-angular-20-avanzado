  "Angular 20 Functional Guard": {
    "prefix": "ng20-guard",
    "body": [
      "import { inject } from '@angular/core';",
      "import { CanActivateFn, Router } from '@angular/router';",
      "import { ${1:AuthService} } from '../services/${2:auth.service}';",
      "",
