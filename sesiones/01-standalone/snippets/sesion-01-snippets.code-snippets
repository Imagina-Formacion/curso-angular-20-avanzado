      "  readonly ${2:data} = this._${2:data}.asReadonly();",
      "  readonly ${4:loading} = this._${4:loading}.asReadonly();",
      "  readonly ${5:error} = this._${5:error}.asReadonly();",
      "",
      "  // 🧮 Computed signals",
      "  readonly ${6:hasData} = computed(() => this._${2:data}().length > 0);",
      "  readonly ${7:isEmpty} = computed(() => this._${2:data}().length === 0);",
      "",
      "  constructor() {",
      "    ${8:// Initialize service}",
      "  }",
      "",
      "  // 📝 Public methods",
      "  async ${9:loadData}(): Promise<void> {",
      "    this._${4:loading}.set(true);",
