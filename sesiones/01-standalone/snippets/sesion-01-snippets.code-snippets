      "      this._${2:data}.set(${2:data});",
      "    } catch (error) {",
      "      this._${5:error}.set(error instanceof Error ? error.message : 'Unknown error');",
      "    } finally {",
      "      this._${4:loading}.set(false);",
      "    }",
      "  }",
      "",
      "  private async ${10:fetchData}(): Promise<${3:any}[]> {",
      "    // Mock implementation",
      "    return new Promise(resolve => {",
      "      setTimeout(() => resolve([]), 1000);",
      "    });",
      "  }",
      "",
      "  ${0:// Additional methods}",
      "}"
    ],
    "description": "Servicio injectable con signals"
  },

