  "Angular 20 Standalone with Signals": {
    "prefix": "ng20-standalone-signals",
    "body": [
      "import { Component, signal, computed } from '@angular/core';",
      "import { CommonModule } from '@angular/common';",
      "",
      "@Component({",
      "  selector: '${1:app-my-component}',",
      "  standalone: true,",
      "  imports: [CommonModule],",
      "  template: `",
      "    <div class=\"${2:component-container}\">",
      "      <h3>{{ ${3:title}() }}</h3>",
      "      <p>Count: {{ ${4:count}() }}</p>",
      "      <p>Double: {{ ${5:doubleCount}() }}</p>",
      "      ",
      "      <button (click)=\"increment()\">+</button>",
      "      <button (click)=\"decrement()\">-</button>",
      "    </div>",
      "  `,",
      "  styles: [`",
      "    .${2:component-container} {",
      "      padding: 1rem;",
      "      border: 1px solid #ddd;",
      "      border-radius: 8px;",
      "    }",
      "    ",
      "    button {",
      "      margin: 0 0.5rem;",
      "      padding: 0.5rem 1rem;",
      "      border: none;",
      "      border-radius: 4px;",
      "      background: #007bff;",
      "      color: white;",
      "      cursor: pointer;",
      "    }",
      "  `]",
      "})",
      "export class ${6:MyComponent} {",
      "  // 📊 Signals privados",
      "  private readonly _${4:count} = signal(${7:0});",
      "  private readonly _${3:title} = signal('${8:My Component}');",
      "  ",
      "  // 🔗 Signals públicos readonly",
      "  readonly ${4:count} = this._${4:count}.asReadonly();",
      "  readonly ${3:title} = this._${3:title}.asReadonly();",
      "  ",
      "  // 🧮 Computed signals",
      "  readonly ${5:doubleCount} = computed(() => this._${4:count}() * 2);",
      "  ",
      "  // 📝 Methods",
      "  increment(): void {",
      "    this._${4:count}.update(count => count + 1);",
      "  }",
      "  ",
      "  decrement(): void {",
      "    this._${4:count}.update(count => count - 1);",
      "  }",
      "  ",
      "  ${0:// Additional methods}",
      "}"
    ],
    "description": "Componente standalone con signals reactivos"
  },

