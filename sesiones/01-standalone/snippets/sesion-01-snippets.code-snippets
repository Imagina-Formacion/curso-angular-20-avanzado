  "Angular 20 Form Component": {
    "prefix": "ng20-form",
    "body": [
      "import { Component, signal } from '@angular/core';",
      "import { CommonModule } from '@angular/common';",
      "import { FormsModule } from '@angular/forms';",
      "",
      "export interface ${1:FormData} {",
      "  ${2:name}: string;",
      "  ${3:email}: string;",
      "  ${4:message}: string;",
      "}",
      "",
      "@Component({",
      "  selector: '${5:app-contact-form}',",
      "  standalone: true,",
      "  imports: [CommonModule, FormsModule],",
      "  template: `",
      "    <form (ngSubmit)=\"onSubmit()\" class=\"${6:contact-form}\">",
      "      <h2>{{ ${7:title} }}</h2>",
      "      ",
      "      <div class=\"form-group\">",
      "        <label for=\"${2:name}\">${8:Name}</label>",
      "        <input",
      "          id=\"${2:name}\"",
      "          type=\"text\"",
      "          [(ngModel)]=\"formData.${2:name}\"",
      "          name=\"${2:name}\"",
      "          required",
      "          class=\"form-input\"",
      "        >",
      "      </div>",
      "      ",
      "      <div class=\"form-group\">",
      "        <label for=\"${3:email}\">${9:Email}</label>",
      "        <input",
      "          id=\"${3:email}\"",
      "          type=\"email\"",
      "          [(ngModel)]=\"formData.${3:email}\"",
      "          name=\"${3:email}\"",
      "          required",
      "          class=\"form-input\"",
      "        >",
      "      </div>",
      "      ",
      "      <div class=\"form-group\">",
      "        <label for=\"${4:message}\">${10:Message}</label>",
      "        <textarea",
      "          id=\"${4:message}\"",
      "          [(ngModel)]=\"formData.${4:message}\"",
      "          name=\"${4:message}\"",
      "          required",
      "          class=\"form-textarea\"",
      "          rows=\"4\"",
      "        ></textarea>",
      "      </div>",
      "      ",
      "      @if (isSubmitting()) {",
      "        <div class=\"loading\">${11:Sending...}</div>",
      "      }",
      "      ",
      "      <button",
      "        type=\"submit\"",
      "        [disabled]=\"!isFormValid() || isSubmitting()\"",
      "        class=\"submit-btn\"",
      "      >",
      "        {{ isSubmitting() ? '${12:Sending...}' : '${13:Send Message}' }}",
      "      </button>",
      "    </form>",
      "  `,",
      "  styles: [`",
      "    .${6:contact-form} {",
      "      max-width: 500px;",
      "      margin: 0 auto;",
      "      padding: 2rem;",
      "    }",
      "    ",
      "    .form-group {",
      "      margin-bottom: 1rem;",
      "    }",
      "    ",
      "    .form-input, .form-textarea {",
      "      width: 100%;",
      "      padding: 0.5rem;",
      "      border: 1px solid #ccc;",
      "      border-radius: 4px;",
      "    }",
      "    ",
      "    .submit-btn {",
      "      background: #007bff;",
      "      color: white;",
      "      padding: 0.75rem 1.5rem;",
      "      border: none;",
      "      border-radius: 4px;",
      "      cursor: pointer;",
      "    }",
      "    ",
      "    .submit-btn:disabled {",
      "      background: #ccc;",
      "      cursor: not-allowed;",
      "    }",
      "  `]",
      "})",
      "export class ${14:ContactFormComponent} {",
      "  ${7:title} = '${15:Contact Us}';",
      "  ",
      "  // 📊 Form state with signals",
      "  private _isSubmitting = signal(false);",
      "  readonly isSubmitting = this._isSubmitting.asReadonly();",
      "  ",
      "  formData: ${1:FormData} = {",
      "    ${2:name}: '',",
      "    ${3:email}: '',",
      "    ${4:message}: ''",
      "  };",
      "  ",
      "  async onSubmit(): Promise<void> {",
      "    if (!this.isFormValid()) return;",
      "    ",
      "    this._isSubmitting.set(true);",
      "    ",
      "    try {",
      "      // 🚀 Submit form data",
      "      await this.submitForm(this.formData);",
      "      this.resetForm();",
      "    } catch (error) {",
      "      console.error('Form submission error:', error);",
      "    } finally {",
      "      this._isSubmitting.set(false);",
      "    }",
      "  }",
      "  ",
      "  isFormValid(): boolean {",
      "    return Object.values(this.formData).every(value => value.trim().length > 0);",
      "  }",
      "  ",
      "  private async submitForm(data: ${1:FormData}): Promise<void> {",
      "    // 📡 Simulate API call",
      "    return new Promise(resolve => setTimeout(resolve, 2000));",
      "  }",
      "  ",
      "  private resetForm(): void {",
      "    this.formData = {",
      "      ${2:name}: '',",
      "      ${3:email}: '',",
      "      ${4:message}: ''",
      "    };",
      "  }",
      "}"
    ],
    "description": "Formulario completo con validación y signals"
  }
