  "Angular 20 Injectable Service": {
    "prefix": "ng20-service",
    "body": [
      "import { Injectable, signal, computed } from '@angular/core';",
      "",
      "export interface ${1:DataModel} {",
      "  id: number;",
      "  ${2:name}: string;",
      "  ${3:active}: boolean;",
      "}",
      "",
      "@Injectable({",
      "  providedIn: 'root'",
      "})",
      "export class ${4:DataService} {",
      "  // 📊 Private signals",
      "  private readonly _${5:items} = signal<${1:DataModel}[]>([]);",
      "  private readonly _loading = signal(false);",
      "  ",
      "  // 🔗 Public readonly signals",
      "  readonly ${5:items} = this._${5:items}.asReadonly();",
      "  readonly loading = this._loading.asReadonly();",
      "  ",
      "  // 🧮 Computed signals",
      "  readonly ${6:activeItems} = computed(() => ",
      "    this._${5:items}().filter(item => item.${3:active})",
      "  );",
      "  ",
      "  readonly ${7:totalCount} = computed(() => this._${5:items}().length);",
      "  ",
      "  // 📝 Methods",
      "  add${1/(.*)/${1:/capitalize}/}(${8:item}: Omit<${1:DataModel}, 'id'>): void {",
      "    const newItem: ${1:DataModel} = {",
      "      ...${8:item},",
      "      id: Math.max(0, ...this._${5:items}().map(i => i.id)) + 1",
      "    };",
      "    ",
      "    this._${5:items}.update(${5:items} => [...${5:items}, newItem]);",
      "  }",
      "  ",
      "  remove${1/(.*)/${1:/capitalize}/}(id: number): void {",
      "    this._${5:items}.update(${5:items} => ${5:items}.filter(item => item.id !== id));",
      "  }",
      "}"
    ],
    "description": "Servicio con signals para standalone components"
  },

