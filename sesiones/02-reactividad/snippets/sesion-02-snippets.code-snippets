  "Angular 20 Structural Directive": {
    "prefix": "ng20-structural-directive",
    "body": [
      "import {",
      "  Directive,",
      "  Input,",
      "  TemplateRef,",
      "  ViewContainerRef,",
      "  inject,",
      "  signal,",
      "  effect,",
      "  computed",
      "} from '@angular/core';",
      "",
      "@Directive({",
      "  selector: '[${1:appMyStructural}]',",
      "  standalone: true",
      "})",
      "export class ${2:MyStructuralDirective} {",
      "  private templateRef = inject(TemplateRef);",
      "  private viewContainer = inject(ViewContainerRef);",
      "  ",
      "  // 📊 Signals para condiciones",
      "  private _condition = signal<${3:boolean}>(false);",
      "  private _isVisible = signal(false);",
      "  ",
      "  @Input() set ${1:appMyStructural}(condition: ${3:boolean}) {",
      "    this._condition.set(condition);",
      "  }",
      "  ",
      "  // 🧮 Computed para lógica de visibilidad",
      "  private shouldShow = computed(() => {",
      "    return ${4:this._condition()};",
      "  });",
      "  ",
      "  constructor() {",
      "    // 🔄 Effect para manejar DOM",
      "    effect(() => {",
      "      const shouldShow = this.shouldShow();",
      "      const currentlyVisible = this._isVisible();",
      "      ",
      "      if (shouldShow && !currentlyVisible) {",
      "        this.viewContainer.createEmbeddedView(this.templateRef);",
      "        this._isVisible.set(true);",
      "      } else if (!shouldShow && currentlyVisible) {",
      "        this.viewContainer.clear();",
      "        this._isVisible.set(false);",
      "      }",
      "    });",
      "  }",
      "}"
    ],
    "description": "Directiva estructural con signals"
  },

  "Angular 20 Reactive Service": {
    "prefix": "ng20-reactive-service",
    "body": [
      "import { Injectable, signal, computed, effect } from '@angular/core';",
      "",
      "export interface ${1:DataModel} {",
      "  id: number;",
      "  ${2:name}: string;",
      "  ${3:status}: '${4:active}' | '${5:inactive}';",
      "}",
      "",
      "@Injectable({",
      "  providedIn: 'root'",
      "})",
      "export class ${6:DataService} {",
      "  // 📊 Estado privado con signals",
      "  private readonly _items = signal<${1:DataModel}[]>([]);",
      "  private readonly _loading = signal(false);",
      "  private readonly _error = signal<string | null>(null);",
      "  private readonly _filter = signal<string>('');",
      "  ",
      "  // 🔗 Signals públicos readonly",
      "  readonly items = this._items.asReadonly();",
      "  readonly loading = this._loading.asReadonly();",
      "  readonly error = this._error.asReadonly();",
      "  readonly filter = this._filter.asReadonly();",
      "  ",
      "  // 🧮 Computed signals",
      "  readonly filteredItems = computed(() => {",
      "    const items = this._items();",
      "    const filter = this._filter().toLowerCase();",
      "    ",
      "    if (!filter) return items;",
      "    ",
      "    return items.filter(item => ",
      "      item.${2:name}.toLowerCase().includes(filter)",
      "    );",
      "  });",
      "  ",
      "  readonly activeItems = computed(() => ",
      "    this._items().filter(item => item.${3:status} === '${4:active}')",
      "  );",
      "  ",
      "  readonly totalCount = computed(() => this._items().length);",
      "  ",
      "  constructor() {",
      "    // 🔄 Effect para persistencia",
      "    effect(() => {",
      "      const items = this._items();",
      "      localStorage.setItem('${6/(.*)/${1:/downcase}/}-data', JSON.stringify(items));",
      "    });",
      "  }",
      "  ",
      "  // 📝 Métodos públicos",
      "  async loadItems(): Promise<void> {",
      "    this._loading.set(true);",
      "    this._error.set(null);",
      "    ",
      "    try {",
      "      const items = await this.fetchItems();",
      "      this._items.set(items);",
      "    } catch (error) {",
      "      this._error.set(error instanceof Error ? error.message : 'Unknown error');",
      "    } finally {",
      "      this._loading.set(false);",
      "    }",
      "  }",
      "  ",
      "  addItem(item: Omit<${1:DataModel}, 'id'>): void {",
      "    const newItem: ${1:DataModel} = {",
      "      ...item,",
      "      id: Math.max(0, ...this._items().map(i => i.id)) + 1",
      "    };",
      "    ",
      "    this._items.update(items => [...items, newItem]);",
      "  }",
      "  ",
      "  updateItem(id: number, updates: Partial<${1:DataModel}>): void {",
      "    this._items.update(items =>",
      "      items.map(item => ",
      "        item.id === id ? { ...item, ...updates } : item",
      "      )",
      "    );",
      "  }",
      "  ",
      "  removeItem(id: number): void {",
      "    this._items.update(items => items.filter(item => item.id !== id));",
      "  }",
      "  ",
      "  setFilter(filter: string): void {",
      "    this._filter.set(filter);",
      "  }",
      "  ",
      "  private async fetchItems(): Promise<${1:DataModel}[]> {",
      "    // Mock API call",
      "    return new Promise(resolve => {",
      "      setTimeout(() => resolve([]), 1000);",
      "    });",
      "  }",
      "}"
    ],
    "description": "Servicio reactivo completo con signals"
  },

  "Angular 20 Signal List Component": {
    "prefix": "ng20-signal-list",
    "body": [
      "import { Component, Input, Output, EventEmitter, signal, computed, ChangeDetectionStrategy } from '@angular/core';",
      "import { CommonModule } from '@angular/common';",
      "",
      "export interface ${1:ListItem} {",
      "  id: number;",
      "  ${2:title}: string;",
      "  ${3:selected}: boolean;",
      "}",
      "",
      "@Component({",
      "  selector: '${4:app-signal-list}',",
      "  standalone: true,",
      "  imports: [CommonModule],",
      "  changeDetection: ChangeDetectionStrategy.OnPush,",
      "  template: `",
      "    <div class=\"signal-list\">",
      "      <div class=\"list-header\">",
      "        <h3>{{ title() }}</h3>",
      "        <div class=\"list-stats\">",
      "          <span>Total: {{ totalItems() }}</span>",
      "          <span>Selected: {{ selectedCount() }}</span>",
      "        </div>",
      "      </div>",
      "      ",
      "      <div class=\"list-content\">",
      "        @for (item of items(); track item.id) {",
      "          <div ",
      "            class=\"list-item\"",
      "            [class.selected]=\"item.${3:selected}\"",
      "            (click)=\"toggleItem(item.id)\"",
      "          >",
      "            <span class=\"item-title\">{{ item.${2:title} }}</span>",
      "            <span class=\"item-status\">",
      "              {{ item.${3:selected} ? '✓' : '○' }}",
      "            </span>",
      "          </div>",
      "        }",
      "        ",
      "        @if (items().length === 0) {",
      "          <div class=\"empty-state\">",
      "            No items available",
      "          </div>",
      "        }",
      "      </div>",
      "      ",
      "      <div class=\"list-actions\">",
      "        <button ",
      "          (click)=\"selectAll()\"",
      "          [disabled]=\"allSelected()\"",
      "          class=\"btn btn-primary\"",
      "        >",
      "          Select All",
      "        </button>",
      "        <button ",
      "          (click)=\"clearSelection()\"",
      "          [disabled]=\"selectedCount() === 0\"",
      "          class=\"btn btn-secondary\"",
      "        >",
      "          Clear Selection",
      "        </button>",
      "      </div>",
      "    </div>",
      "  `,",
      "  styles: [`",
      "    .signal-list {",
      "      border: 1px solid #e9ecef;",
      "      border-radius: 8px;",
      "      overflow: hidden;",
      "    }",
      "    ",
      "    .list-header {",
      "      background: #f8f9fa;",
      "      padding: 1rem;",
      "      display: flex;",
      "      justify-content: space-between;",
      "      align-items: center;",
      "    }",
      "    ",
      "    .list-stats {",
      "      display: flex;",
      "      gap: 1rem;",
      "      font-size: 0.9rem;",
      "      color: #6c757d;",
      "    }",
      "    ",
      "    .list-content {",
      "      max-height: 300px;",
      "      overflow-y: auto;",
      "    }",
      "    ",
      "    .list-item {",
      "      display: flex;",
      "      justify-content: space-between;",
      "      align-items: center;",
      "      padding: 0.75rem 1rem;",
      "      border-bottom: 1px solid #f8f9fa;",
      "      cursor: pointer;",
      "      transition: background-color 0.2s;",
      "    }",
      "    ",
      "    .list-item:hover {",
      "      background: #f8f9fa;",
      "    }",
      "    ",
      "    .list-item.selected {",
      "      background: #e3f2fd;",
      "      border-color: #2196f3;",
      "    }",
      "    ",
      "    .empty-state {",
      "      text-align: center;",
      "      padding: 2rem;",
      "      color: #6c757d;",
      "      font-style: italic;",
      "    }",
      "    ",
      "    .list-actions {",
      "      padding: 1rem;",
      "      background: #f8f9fa;",
      "      display: flex;",
      "      gap: 0.5rem;",
      "    }",
      "    ",
      "    .btn {",
      "      padding: 0.5rem 1rem;",
      "      border: none;",
      "      border-radius: 4px;",
      "      cursor: pointer;",
      "      transition: all 0.2s;",
      "    }",
      "    ",
      "    .btn-primary {",
      "      background: #007bff;",
      "      color: white;",
      "    }",
      "    ",
      "    .btn-secondary {",
      "      background: #6c757d;",
      "      color: white;",
      "    }",
      "    ",
      "    .btn:disabled {",
      "      opacity: 0.6;",
      "      cursor: not-allowed;",
      "    }",
      "  `]",
      "})",
      "export class ${5:SignalListComponent} {",
      "  // 📊 Input signals",
      "  private readonly _items = signal<${1:ListItem}[]>([]);",
      "  private readonly _title = signal('${6:List Title}');",
      "  ",
      "  @Input() set items(value: ${1:ListItem}[]) {",
      "    this._items.set(value);",
      "  }",
      "  ",
      "  @Input() set title(value: string) {",
      "    this._title.set(value);",
      "  }",
      "  ",
      "  // 📤 Output events",
      "  @Output() itemToggled = new EventEmitter<number>();",
      "  @Output() selectionChanged = new EventEmitter<number[]>();",
      "  ",
      "  // 🔗 Public readonly signals",
      "  readonly items = this._items.asReadonly();",
      "  readonly title = this._title.asReadonly();",
      "  ",
      "  // 🧮 Computed signals",
      "  readonly totalItems = computed(() => this._items().length);",
      "  readonly selectedCount = computed(() => ",
      "    this._items().filter(item => item.${3:selected}).length",
      "  );",
      "  readonly allSelected = computed(() => {",
      "    const items = this._items();",
      "    return items.length > 0 && items.every(item => item.${3:selected});",
      "  });",
      "  readonly selectedIds = computed(() => ",
      "    this._items().filter(item => item.${3:selected}).map(item => item.id)",
      "  );",
      "  ",
      "  // 📝 Methods",
      "  toggleItem(id: number): void {",
      "    this._items.update(items =>",
      "      items.map(item =>",
      "        item.id === id ? { ...item, ${3:selected}: !item.${3:selected} } : item",
      "      )",
      "    );",
      "    ",
      "    this.itemToggled.emit(id);",
      "    this.selectionChanged.emit(this.selectedIds());",
      "  }",
      "  ",
      "  selectAll(): void {",
      "    this._items.update(items =>",
      "      items.map(item => ({ ...item, ${3:selected}: true }))",
      "    );",
      "    ",
      "    this.selectionChanged.emit(this.selectedIds());",
      "  }",
      "  ",
      "  clearSelection(): void {",
      "    this._items.update(items =>",
      "      items.map(item => ({ ...item, ${3:selected}: false }))",
      "    );",
      "    ",
      "    this.selectionChanged.emit([]);",
      "  }",
      "}"
    ],
    "description": "Lista optimizada con signals y OnPush"
  },

  "Angular 20 Loading Directive": {
    "prefix": "ng20-loading-directive",
    "body": [
      "import {",
      "  Directive,",
      "  Input,",
      "  ElementRef,",
      "  Renderer2,",
      "  inject,",
      "  signal,",
      "  effect",
      "} from '@angular/core';",
      "",
      "export type LoadingState = 'idle' | 'loading' | 'success' | 'error';",
      "",
      "@Directive({",
      "  selector: '[${1:appLoading}]',",
      "  standalone: true",
      "})",
      "export class ${2:LoadingDirective} {",
      "  private elementRef = inject(ElementRef);",
      "  private renderer = inject(Renderer2);",
      "  ",
      "  // 📊 Signals para estado",
      "  private _loadingState = signal<LoadingState>('idle');",
      "  private _loadingText = signal('Loading...');",
      "  ",
      "  private originalText: string = '';",
      "  private originalDisabled: boolean = false;",
      "  ",
      "  @Input() set ${1:appLoading}(state: LoadingState) {",
      "    this._loadingState.set(state);",
      "  }",
      "  ",
      "  @Input() set ${1:appLoading}Text(text: string) {",
      "    this._loadingText.set(text);",
      "  }",
      "  ",
      "  constructor() {",
      "    // Store original state",
      "    const element = this.elementRef.nativeElement;",
      "    this.originalText = element.textContent || element.value || '';",
      "    this.originalDisabled = element.disabled || false;",
      "    ",
      "    // 🔄 Effect para manejar estados",
      "    effect(() => {",
      "      const state = this._loadingState();",
      "      ",
      "      switch (state) {",
      "        case 'loading':",
      "          this.applyLoadingState();",
      "          break;",
      "        case 'success':",
      "          this.applySuccessState();",
      "          break;",
      "        case 'error':",
      "          this.applyErrorState();",
      "          break;",
      "        default:",
      "          this.restoreOriginalState();",
      "      }",
      "    });",
      "  }",
      "  ",
      "  private applyLoadingState(): void {",
      "    const element = this.elementRef.nativeElement;",
      "    const loadingText = `⟳ ${this._loadingText()}`;",
      "    ",
      "    if (element.tagName === 'BUTTON') {",
      "      element.textContent = loadingText;",
      "      element.disabled = true;",
      "    }",
      "    ",
      "    this.renderer.addClass(element, 'loading');",
      "    this.renderer.setStyle(element, 'cursor', 'wait');",
      "  }",
      "  ",
      "  private applySuccessState(): void {",
      "    const element = this.elementRef.nativeElement;",
      "    ",
      "    if (element.tagName === 'BUTTON') {",
      "      element.textContent = '✅ Success!';",
      "    }",
      "    ",
      "    this.renderer.addClass(element, 'success');",
      "    ",
      "    // Auto-restore after 2 seconds",
      "    setTimeout(() => {",
      "      if (this._loadingState() === 'success') {",
      "        this._loadingState.set('idle');",
      "      }",
      "    }, 2000);",
      "  }",
      "  ",
      "  private applyErrorState(): void {",
      "    const element = this.elementRef.nativeElement;",
      "    ",
      "    if (element.tagName === 'BUTTON') {",
      "      element.textContent = '❌ Error!';",
      "    }",
      "    ",
      "    this.renderer.addClass(element, 'error');",
      "    ",
      "    // Auto-restore after 3 seconds",
      "    setTimeout(() => {",
      "      if (this._loadingState() === 'error') {",
      "        this._loadingState.set('idle');",
      "      }",
      "    }, 3000);",
      "  }",
      "  ",
      "  private restoreOriginalState(): void {",
      "    const element = this.elementRef.nativeElement;",
      "    ",
      "    element.textContent = this.originalText;",
      "    element.disabled = this.originalDisabled;",
      "    ",
      "    this.renderer.removeClass(element, 'loading');",
      "    this.renderer.removeClass(element, 'success');",
      "    this.renderer.removeClass(element, 'error');",
      "    this.renderer.setStyle(element, 'cursor', 'default');",
      "  }",
      "}"
    ],
    "description": "Directiva de loading con estados reactivos"
  }
}