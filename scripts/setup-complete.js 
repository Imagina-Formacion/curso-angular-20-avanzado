#!/usr/bin/env node

const fs = require('fs-extra');
const path = require('path');
const { execSync } = require('child_process');
const chalk = require('chalk');
const ora = require('ora');
const boxen = require('boxen');

class CourseSetup {
  constructor() {
    this.spinner = ora();
    this.courseDir = process.cwd();
    this.campusPath = path.join(this.courseDir, 'campus-virtual-eso');
  }

  async run() {
    console.log(boxen(
      chalk.blue.bold('🎓 SETUP CURSO ANGULAR 20\n') +
      chalk.white('Campus Virtual ESO - Setup Inicial Completo\n') +
      chalk.gray('Imagina Formación | 2025'),
      {
        padding: 1,
        margin: 1,
        borderStyle: 'double',
        borderColor: 'blue'
      }
    ));

    try {
      await this.checkPrerequisites();
      await this.createCampusProject();
      await this.setupVSCodeConfiguration();
      await this.createMockData();
      await this.installDependencies();

      this.showSuccessMessage();
    } catch (error) {
      this.handleError(error);
    }
  }

  async checkPrerequisites() {
    console.log(chalk.yellow('\n📋 Verificando prerequisitos...\n'));

    // Node.js
    this.spinner.start('Verificando Node.js...');
    try {
      const nodeVersion = process.version.slice(1);
      if (this.compareVersions(nodeVersion, '18.19.0') < 0) {
        throw new Error(`Node.js >= 18.19.0 requerido. Actual: ${nodeVersion}`);
      }
      this.spinner.succeed(`Node.js ${nodeVersion} ✅`);
    } catch (error) {
      this.spinner.fail('Node.js insuficiente');
      throw error;
    }

    // Angular CLI
    this.spinner.start('Verificando Angular CLI...');
    try {
      const output = execSync('ng version --json', { encoding: 'utf8', stdio: 'pipe' });
      const data = JSON.parse(output);
      const cliVersion = data.cli?.version;

      if (!cliVersion || this.compareVersions(cliVersion, '18.0.0') < 0) {
        this.spinner.warn('Actualizando Angular CLI...');
        execSync('npm install -g @angular/cli@latest', { stdio: 'pipe' });
      }
      this.spinner.succeed(`Angular CLI ${cliVersion || 'latest'} ✅`);
    } catch (error) {
      this.spinner.warn('Instalando Angular CLI...');
      execSync('npm install -g @angular/cli@latest', { stdio: 'pipe' });
      this.spinner.succeed('Angular CLI instalado ✅');
    }
  }

  async createCampusProject() {
    console.log(chalk.yellow('\n🏗️ Creando proyecto Campus Virtual ESO...\n'));

    if (await fs.pathExists(this.campusPath)) {
      this.spinner.succeed('Proyecto Campus Virtual ya existe ✅');
      return;
    }

    this.spinner.start('Creando proyecto Angular...');
    try {
      const ngNewCommand = [
        'ng new campus-virtual-eso',
        '--routing=true',
        '--style=scss',
        '--strict=true',
        '--standalone=true',
        '--ssr=false',
        '--skip-git=true',
        '--package-manager=npm',
        '--directory=campus-virtual-eso'
      ].join(' ');

      execSync(ngNewCommand, { stdio: 'pipe', cwd: this.courseDir });
      this.spinner.succeed('Proyecto Angular creado ✅');
    } catch (error) {
      this.spinner.fail('Error creando proyecto');
      throw error;
    }

    // Actualizar configuración para Zoneless
    await this.configureZoneless();
  }

  async configureZoneless() {
    this.spinner.start('Configurando Zoneless Angular...');

    try {
      const appConfigPath = path.join(this.campusPath, 'src/app/app.config.ts');
      const appConfigContent = `import { ApplicationConfig } from '@angular/core';
import { provideRouter } from '@angular/router';
import { provideHttpClient } from '@angular/common/http';
import { provideAnimations } from '@angular/platform-browser/animations';
import { provideExperimentalZonelessChangeDetection } from '@angular/core';

import { routes } from './app.routes';

export const appConfig: ApplicationConfig = {
  providers: [
    // 🎯 Zoneless Change Detection para Angular 20
    provideExperimentalZonelessChangeDetection(),

    provideRouter(routes),
    provideHttpClient(),
    provideAnimations()
  ]
};`;

      await fs.writeFile(appConfigPath, appConfigContent);
      this.spinner.succeed('Zoneless Angular configurado ✅');
    } catch (error) {
      this.spinner.warn('No se pudo configurar Zoneless (se hará en sesión)');
    }
  }

  async setupVSCodeConfiguration() {
    console.log(chalk.yellow('\n🔧 Configurando VS Code...\n'));

    const vscodeDir = path.join(this.campusPath, '.vscode');
    await fs.ensureDir(vscodeDir);

    // Settings optimizados para Angular 20
    const settings = {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      },
      "typescript.preferences.importModuleSpecifier": "relative",
      "angular.enable-strict-mode-prompt": false,
      "emmet.includeLanguages": {
        "typescript": "html"
      },
      "files.associations": {
        "*.html": "html"
      }
    };

    // Extensiones esenciales
    const extensions = {
      "recommendations": [
        "angular.ng-template",
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-eslint",
        "streetsidesoftware.code-spell-checker"
      ]
    };

    this.spinner.start('Configurando VS Code...');
    try {
      await fs.writeJson(path.join(vscodeDir, 'settings.json'), settings, { spaces: 2 });
      await fs.writeJson(path.join(vscodeDir, 'extensions.json'), extensions, { spaces: 2 });
      this.spinner.succeed('VS Code configurado ✅');
    } catch (error) {
      this.spinner.warn('VS Code no configurado completamente');
    }
  }

  async createMockData() {
    console.log(chalk.yellow('\n📊 Creando datos mock del Campus ESO...\n'));

    const dataDir = path.join(this.campusPath, 'src/assets/data');
    await fs.ensureDir(dataDir);

    // Mock data realista para ESO
    const mockData = {
      students: [
        {
          id: 1,
          name: "María García López",
          email: "maria.garcia@eso.edu",
          role: "student",
          course: "3º ESO A",
          subjects: ["Matemáticas", "Lengua", "Ciencias Naturales", "Historia"],
          avatar: "/assets/images/students/maria.jpg"
        },
        {
          id: 2,
          name: "Carlos Ruiz Martín",
          email: "carlos.ruiz@eso.edu",
          role: "student",
          course: "4º ESO B",
          subjects: ["Física", "Química", "Literatura", "Inglés"],
          avatar: "/assets/images/students/carlos.jpg"
        }
      ],
      teachers: [
        {
          id: 101,
          name: "Ana López Sánchez",
          email: "ana.lopez@eso.edu",
          role: "teacher",
          subjects: ["Matemáticas", "Física"],
          courses: ["3º ESO A", "4º ESO A", "4º ESO B"],
          avatar: "/assets/images/teachers/ana.jpg"
        },
        {
          id: 102,
          name: "Juan Rodríguez Pérez",
          email: "juan.rodriguez@eso.edu",
          role: "teacher",
          subjects: ["Lengua", "Literatura"],
          courses: ["3º ESO A", "3º ESO B"],
          avatar: "/assets/images/teachers/juan.jpg"
        }
      ],
      courses: [
        {
          id: 1,
          name: "Matemáticas 3º ESO",
          description: "Álgebra, geometría y estadística para 3º ESO",
          teacher: "Ana López",
          teacherId: 101,
          students: 25,
          schedule: "Lunes, Miércoles, Viernes 10:00-11:00",
          classroom: "Aula 15"
        },
        {
          id: 2,
          name: "Lengua 3º ESO",
          description: "Literatura española y expresión escrita",
          teacher: "Juan Rodríguez",
          teacherId: 102,
          students: 22,
          schedule: "Martes, Jueves 09:00-10:00",
          classroom: "Aula 8"
        }
      ],
      messages: [
        {
          id: 1,
          from: 101,
          to: 1,
          subject: "Tarea de matemáticas",
          content: "Recuerda entregar los ejercicios del tema 5 antes del viernes.",
          date: "2025-09-25",
          read: false,
          type: "assignment"
        },
        {
          id: 2,
          from: 1,
          to: 101,
          subject: "Consulta sobre examen",
          content: "¿Podría explicarme el ejercicio 3 de la página 87?",
          date: "2025-09-24",
          read: true,
          type: "question"
        }
      ]
    };

    this.spinner.start('Generando datos mock...');
    try {
      await fs.writeJson(path.join(dataDir, 'students.json'), mockData.students, { spaces: 2 });
      await fs.writeJson(path.join(dataDir, 'teachers.json'), mockData.teachers, { spaces: 2 });
      await fs.writeJson(path.join(dataDir, 'courses.json'), mockData.courses, { spaces: 2 });
      await fs.writeJson(path.join(dataDir, 'messages.json'), mockData.messages, { spaces: 2 });

      this.spinner.succeed('Datos mock ESO creados ✅');
    } catch (error) {
      this.spinner.warn('Datos mock no creados completamente');
    }
  }

  async installDependencies() {
    console.log(chalk.yellow('\n📦 Instalando dependencias...\n'));

    this.spinner.start('Instalando dependencias del curso...');
    try {
      // Instalar dependencias del repositorio principal
      execSync('npm install', { stdio: 'pipe', cwd: this.courseDir });

      // Instalar dependencias del proyecto Campus
      execSync('npm install', { stdio: 'pipe', cwd: this.campusPath });

      this.spinner.succeed('Dependencias instaladas ✅');
    } catch (error) {
      this.spinner.fail('Error instalando dependencias');
      throw error;
    }
  }

  showSuccessMessage() {
    console.log(boxen(
      chalk.green.bold('🎉 ¡SETUP COMPLETADO!\n\n') +
      chalk.white('✅ Estructura del curso creada\n') +
      chalk.white('✅ Proyecto Campus Virtual ESO configurado\n') +
      chalk.white('✅ VS Code optimizado para Angular 20\n') +
      chalk.white('✅ Datos mock ESO generados\n') +
      chalk.white('✅ Dependencias instaladas\n\n') +
      chalk.green.bold('🚀 ¡Listo para comenzar el curso!'),
      {
        padding: 1,
        borderStyle: 'double',
        borderColor: 'green'
      }
    ));

    console.log(chalk.cyan('\n📚 Próximos pasos:\n'));
    console.log(chalk.white('   1. cd campus-virtual-eso'));
    console.log(chalk.white('   2. npm start'));
    console.log(chalk.white('   3. Abrir http://localhost:4200'));
    console.log(chalk.white('   4. npm run verify:setup (verificar instalación)'));

    console.log(chalk.yellow('\n🏷️ Crear tags:\n'));
    console.log(chalk.white('   git add .'));
    console.log(chalk.white('   git commit -m "feat: setup inicial completo"'));
    console.log(chalk.white('   git tag v0.0.0-base'));
  }

  handleError(error) {
    console.log(boxen(
      chalk.red.bold('❌ ERROR EN SETUP\n\n') +
      chalk.white(`${error.message}\n\n`) +
      chalk.red.bold('🔧 Revisa los prerequisitos'),
      {
        padding: 1,
        borderStyle: 'single',
        borderColor: 'red'
      }
    ));
    process.exit(1);
  }

  compareVersions(version1, version2) {
    const v1 = version1.split('.').map(Number);
    const v2 = version2.split('.').map(Number);

    for (let i = 0; i < Math.max(v1.length, v2.length); i++) {
      const part1 = v1[i] || 0;
      const part2 = v2[i] || 0;

      if (part1 < part2) return -1;
      if (part1 > part2) return 1;
    }
    return 0;
  }
}

// Ejecutar setup
if (require.main === module) {
  new CourseSetup().run().catch(console.error);
}

module.exports = CourseSetup;
